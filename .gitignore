# Build output
bin/
obj/
out/
*.tpk
*.wgt

# Firmware build artefacts (the .uf2 is attached to a release, not committed per build)
firmware/build/

# Signing material — NEVER commit (certs, profiles, passwords)
*.p12
*.pem
*.pfx
*.jks
*.keystore
*.key
certs/
profiles.xml
author-signature.xml
signature1.xml
tizen-studio-data/

# Local settings (may hold LAN addresses) and credentials — never commit
TizenAmbilight/config.json
.env
.env.*
*.cred
*.secret
credentials.json

# Local/editor noise
.vs/
.vscode/
*.user
*.suo
*~
.DS_Store
.serena/
.idea/

# Python bytecode
__pycache__/
*.pyc
